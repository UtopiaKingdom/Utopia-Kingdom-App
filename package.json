{
  "name": "utopia-kingdom",
  "version": "3.3.26",
  "description": "Utopia Kingdom - Trading Platform",
  "main": "main.js",
  "author": "Utopia Kingdom",
  "homepage": "https://www.utkingdom.com",
  "scripts": {
    "start": "node scripts/start-dev.js",
    "smoke": "node tools/utk_system_smoke.js",
    "test:guards": "node tools/test_ipc_url_guards.js",
    "dev:ws": "node ws_server.js",
    "dev:coinbase": "node coinbase-server.js",
    "dev:paddle": "node paddle-server.js",
    "check:packaging": "node tools/check_packaged_assets.js",
    "publish-bot-status": "node tools/publish_bot_status.js",
    "tunnel": "cloudflared --config ./cloudflared.yml tunnel run utkingdom",
    "build": "npm run prebuild:win && electron-builder",
    "build:win": "electron-builder --win",
    "prebuild:win": "node scripts/generate-windows-icon.js && node scripts/generate-installer-sidebar.js && node scripts/bundle_python_runtime.js && node tools/check_packaged_assets.js",
    "prebuild:win:dir": "powershell -ExecutionPolicy Bypass -File scripts\\kill-running-app.ps1 && node scripts\\bundle_python_runtime.js && node tools\\check_packaged_assets.js",
    "bundle:python": "node scripts/bundle_python_runtime.js",
    "build:win:dir": "electron-builder --win --dir",
    "build:win:inno": "npm run build:win:dir && powershell -ExecutionPolicy Bypass -File scripts\\build-inno.ps1",
    "build:inno": "npm run build:win:inno",
    "build:win:nsis-web": "electron-builder --win nsis-web",
    "build:win:publish-nsis": "electron-builder --win nsis-web --publish always",
    "build:mac": "npm run prebuild:mac && electron-builder --mac",
    "prebuild:mac": "node scripts/prepare_mac_python.js && node tools/check_packaged_assets.js",
    "build:linux": "electron-builder --linux",
    "publish": "electron-builder --publish always",
    "upload:r2": "node tools/upload_build_to_r2.js",
    "upload:mac:r2": "node tools/upload_mac_build_to_r2.js",
    "upload:site:r2": "node tools/upload_website_to_r2.js",
    "delete:trades:bot": "node tools/delete_trades_by_bot.js",
    "set:admin": "node set-admin.js",
    "set:signal-writer": "node set-signal-writer.js",
    "signal-writer": "node signal-writer-server.js"
  },
  "build": {
    "asar": true,
    "asarUnpack": [
      "**/node_modules/keytar/**",
      "PO SSID Collector/**"
    ],
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "logo.png",
        "to": "logo.png"
      },
      {
        "from": ".venv",
        "to": "venv"
      }
    ],
    "appId": "com.utkingdom.trading",
    "productName": "Utopia Kingdom",
    "directories": {
      "output": "dist"
    },
